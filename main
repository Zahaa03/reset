# reset
@echo off
title SYSTEM WIPE SIMULATION
color 0A
cls

echo.
echo        WINDOWS SYSTEM WIPE
echo.
echo        Initializing...
timeout /t 2 >nul

taskkill /f /im explorer.exe >nul 2>&1

cls
echo.
echo        SYSTEM ERASED
echo.
echo        ALL USER DATA HIDDEN
echo.
echo        SIMULATION ACTIVE
echo.
echo        Press any key to exit...
pause >nul

start explorer.exe
exit


@echo off
start explorer.exe
exit
